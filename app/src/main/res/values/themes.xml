<resources>
    <!-- Base application theme. -->
    <style name="Theme.NoActionBar" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/teal_200</item>
        <item name="colorPrimaryVariant">@color/teal_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <!-- Customize your theme here. -->
    </style>

    <!-- TextView -->
    <style name="StyleTextView">
        <item name="android:paddingBottom">5dp</item>
        <item name="android:textSize">25sp</item>
        <item name="android:textColor">?colorError</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
    </style>

    <style name="Base.Widget.MaterialComponents.TextInputLayout.style" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="android:textColorHint">#05A1AD</item>
        <item name="boxStrokeColor">#05A1AD</item>
        <item name="colorOnContainer">#05A1AD</item>
        <item name="boxCornerRadiusBottomStart">10dp</item>
        <item name="boxCornerRadiusBottomEnd">10dp</item>
        <item name="boxCornerRadiusTopEnd">10dp</item>
        <item name="boxCornerRadiusTopStart">10dp</item>
    </style>

    <style name="Theme.StockMarketApp" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@color/dark</item>
        <item name="android:windowBackground">@color/dark</item>
    </style>

    <!--Search Box-->
    <style name="changeBackgroundColor" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="colorSurface">?mc_tick</item>
        <item name="endIconTint">@color/white</item>
    </style>

    <!-- Base application theme. -->
    <style name="Base.ToDoTheme.MainApp" parent="Theme.Material3.DayNight">
        <item name="android:statusBarColor">@color/white</item>
        <item name="android:windowLightStatusBar">true</item>
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/basic_2</item>
        <item name="colorAccent">@color/basic_2</item>
        <item name="color">@color/white</item>
        <item name="mc_bg">@color/basic_2</item>
        <item name="mc_tick">@color/basic_2</item>
        <item name="mc_track">@color/basic_2</item>
        <item name="colorOnBackground">@color/white</item>
        <item name="colorError">@color/dark</item>
        <item name="colorOnError">@color/basic_2</item>

        <item name="toolbarStyle">@style/Widget.MyApp.Toolbar</item>
        <item name="actionBarTheme">@style/ThemeOverlay.MyApp.Toolbar</item>
        <item name="drawerArrowStyle">@style/Widget.MyApp.DrawerArrowStyle</item>
        <!--
               <item name="android:navigationBarColor">@color/basic_2</item>
               <item name="android:windowLightNavigationBar">true</item> -->
    </style>

    <style name="ToDoTheme.MainApp" parent="Base.ToDoTheme.MainApp" />

    <!-- Define the checkbox specific theme override -->
    <style name="Widget.App.CheckBox" parent="Widget.Material3.CompoundButton.CheckBox">
        <!-- Color when checked -->
        <item name="colorPrimary">@color/basic_2</item>
    </style>

    <style name="Widget.MyApp.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@color/basic_2</item>
    </style>

    <style name="ThemeOverlay.MyApp.Toolbar" parent="ThemeOverlay.Material3.ActionBar">
        <item name="titleTextColor">@color/white</item>
        <item name="colorOnSurface">@color/white</item>
        <item name="colorOnSurfaceVariant">@color/white</item>
        <item name="android:textColorPrimary">@color/white</item>
        <item name="colorControlNormal">@color/white</item>
        <item name="editTextColor">@color/white</item>
        <item name="android:textColorHint">@color/white</item>
    </style>

    <style name="Widget.MyApp.DrawerArrowStyle" parent="Widget.AppCompat.DrawerArrowToggle">
        <item name="color">@color/white</item>
    </style>

    <style name="ActiveIndicatorRed" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/white</item>
    </style>

    <style name="ShapeAppearance.Circle" parent="">
        <item name="cornerSize">50%</item>
    </style>
</resources>